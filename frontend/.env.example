# Backend API Base URL
# Local Development:
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# (or /api/v1 when using Vite proxy)
#
# Production Deployment (e.g. Render, Railway, AWS, Vercel):
# Set this in your deployment platform's environment variables:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
